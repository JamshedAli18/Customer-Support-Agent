# Groq (LLM + Whisper STT)
GROQ_API_KEY=your_groq_api_key_here

# Cartesia (primary TTS)
CARTESIA_API_KEY=your_cartesia_api_key_here

# Deepgram (fallback TTS)
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Cohere (embeddings)
COHERE_API_KEY=your_cohere_api_key_here

# Pinecone (vector database)
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=voicecart-kb

# MongoDB Atlas
MONGODB_URI=your_mongodb_connection_string_here
MONGODB_DB_NAME=voicecart

# Resend (email)
RESEND_API_KEY=your_resend_api_key_here
SUPPORT_EMAIL_TO=your_support_inbox_email_here

# Slack Webhooks
SLACK_WEBHOOK_ORDERS=your_orders_channel_webhook_url_here
SLACK_WEBHOOK_SUPPORT_TICKETS=your_support_tickets_channel_webhook_url_here
SLACK_WEBHOOK_WARRANTY_CLAIMS=your_warranty_claims_channel_webhook_url_here

# LangSmith (tracing/observability)
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=voicecart

# Comma-separated list of email addresses allowed to receive real
# order confirmation emails. Anyone else's order still books normally,
# but the email step is silently skipped — protects against sending
# from your personal Gmail account to arbitrary public visitors.
ALLOWED_EMAIL_RECIPIENTS=your_test_email@gmail.com,another_test_email@gmail.com